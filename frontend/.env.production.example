# ──────────────────────────────────────────────────────────────────────────────

# URL base del backend Django.
# Apunta al servicio de backend en Railway.
# Incluye el path /api al final.
# Ejemplo: https://backend-production-xxxx.up.railway.app/api
VITE_API_URL=https://TU-BACKEND.up.railway.app/api
